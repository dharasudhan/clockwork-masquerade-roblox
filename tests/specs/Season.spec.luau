return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	local Season = t.load("Logic/Season")
	local Cfg = t.load("Config/Season")

	local scheduled = { Id = "test", StartsAt = 100, EndsAt = 200, XpPerTier = 250, TierCount = 10 }

	describe("Season", function()
		it("is inactive until scheduled (StartsAt == 0)", function()
			expect(Season.active(Cfg, 999999)).to.equal(false)
		end)
		it("active only inside the scheduled window", function()
			expect(Season.active(scheduled, 99)).to.equal(false)
			expect(Season.active(scheduled, 100)).to.equal(true)
			expect(Season.active(scheduled, 199)).to.equal(true)
			expect(Season.active(scheduled, 200)).to.equal(false)
		end)
		it("tierFor advances per XpPerTier and caps at TierCount", function()
			expect(Season.tierFor(0, scheduled)).to.equal(1)
			expect(Season.tierFor(249, scheduled)).to.equal(1)
			expect(Season.tierFor(250, scheduled)).to.equal(2)
			expect(Season.tierFor(2500, scheduled)).to.equal(10)
			expect(Season.tierFor(10 ^ 9, scheduled)).to.equal(10)
		end)
		it("progress reports tier, XP into tier and need", function()
			local tier, into, need = Season.progress(600, scheduled)
			expect(tier).to.equal(3)
			expect(into).to.equal(100)
			expect(need).to.equal(250)
			local t2, i2, n2 = Season.progress(10 ^ 9, scheduled)
			expect(t2).to.equal(10)
			expect(i2).to.equal(0)
			expect(n2).to.equal(0)
		end)
	end)
end
