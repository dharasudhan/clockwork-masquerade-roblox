return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	local Vote = t.load("Logic/Vote")
	local Progression = t.load("Logic/Progression")
	local Prog = t.load("Config/Progression")
	local Nights = t.load("Config/Nights")
	local valid = { a = true, b = true, c = true, d = true, e = true, f = true }
	describe("Expose voting", function()
		it("one vote per voter (changeable), no self votes, unknown targets refused", function()
			local v = Vote.new()
			expect((Vote.cast(v, "a", "a", valid))).to.equal(false)
			expect((Vote.cast(v, "a", "zz", valid))).to.equal(false)
			expect((Vote.cast(v, "a", "b", valid))).to.equal(true)
			expect((Vote.cast(v, "a", "c", valid))).to.equal(true)
			local counts, n = Vote.tally(v)
			expect(n).to.equal(1)
			expect(counts.c).to.equal(1)
			expect(counts.b).to.equal(nil)
		end)
		it("clear majority exposes; ties, too few votes and too small a share do not", function()
			local v = Vote.new()
			Vote.cast(v, "a", "f", valid)
			Vote.cast(v, "b", "f", valid)
			Vote.cast(v, "c", "f", valid)
			Vote.cast(v, "d", "e", valid)
			expect((Vote.result(v, 6, 2, 0.4))).to.equal("f")
			local tie = Vote.new()
			Vote.cast(tie, "a", "f", valid)
			Vote.cast(tie, "b", "f", valid)
			Vote.cast(tie, "c", "e", valid)
			Vote.cast(tie, "d", "e", valid)
			expect((Vote.result(tie, 6, 2, 0.4))).to.equal(nil)
			local one = Vote.new()
			Vote.cast(one, "a", "f", valid)
			expect((Vote.result(one, 6, 2, 0.4))).to.equal(nil)
			local share = Vote.new()
			Vote.cast(share, "a", "f", valid)
			Vote.cast(share, "b", "f", valid)
			expect((Vote.result(share, 10, 2, 0.4))).to.equal(nil) -- 2 of 10 < 40%
			expect(#Vote.votersFor(v, "f")).to.equal(3)
		end)
		it("a clue always names the tamperer's ribbon plus one other", function()
			for _, r in { 0, 0.3, 0.6, 0.99 } do
				local c = Vote.clue("Crimson", { "Azure", "Emerald" }, r)
				expect(#c).to.equal(2)
				expect(c[1] == "Crimson" or c[2] == "Crimson").to.equal(true)
			end
		end)
	end)
	describe("Progression", function()
		it("levels from XP", function()
			expect((Progression.levelFor(0, Prog))).to.equal(1)
			expect((Progression.levelFor(Prog.LevelBase, Prog))).to.equal(2)
			expect((Progression.levelFor(Prog.LevelBase + Prog.LevelBase + Prog.LevelStep, Prog))).to.equal(3)
		end)
		it("daily streak: +1 on consecutive days, restart after a gap, loop after 7, once a day", function()
			expect(select(2, Progression.daily(10, 3, 10, 7))).to.equal(false)
			expect((Progression.daily(10, 3, 11, 7))).to.equal(4)
			expect((Progression.daily(10, 3, 13, 7))).to.equal(1)
			expect((Progression.daily(10, 7, 11, 7))).to.equal(1)
			expect(#Prog.Daily).to.equal(7)
		end)
		it("shop: tokens buy token items only; free/level/pass ownership", function()
			local data = { GearTokens = 200, Owned = {}, Level = 1 }
			expect((Progression.canBuy({ id = "x", tokens = 150 }, data))).to.equal(true)
			expect((Progression.canBuy({ id = "y", tokens = 300 }, data))).to.equal(false)
			expect((Progression.canBuy({ id = "z", level = 2 }, data))).to.equal(false)
			expect(Progression.owns({ id = "z", level = 2 }, { Owned = {}, Level = 2 })).to.equal(true)
			expect(Progression.owns({ id = "v", pass = "VIP" }, data, { VIP = true })).to.equal(true)
			expect(Progression.owns({ id = "v", pass = "VIP" }, data, {})).to.equal(false)
		end)
		it("finale ring: more guests fill faster (capped), a Phantom halves it; nights won shorten it", function()
			local F = Nights[3].finale
			expect(Progression.ringRate(0, 0, F)).to.equal(0)
			expect(Progression.ringRate(1, 0, F)).to.equal(1)
			expect(Progression.ringRate(2, 0, F)).to.equal(1.25)
			expect(Progression.ringRate(9, 0, F)).to.equal(F.ringRateMax)
			expect(Progression.ringRate(1, 1, F)).to.equal(0.5)
			expect(Progression.ringNeed(F, 0)).to.equal(F.ringSeconds)
			expect(Progression.ringNeed(F, 2)).to.equal(F.ringSeconds - 2 * F.ringBonusPerNightWon)
		end)
	end)
end
