return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	local Escalation = t.load("Logic/Escalation")
	local Cfg = t.load("Config/Escalation")

	describe("Escalation", function()
		it("scales up across nights and clamps past the table", function()
			local n1 = Escalation.forNight(Cfg, 1)
			local n2 = Escalation.forNight(Cfg, 2)
			local n3 = Escalation.forNight(Cfg, 3)
			local n9 = Escalation.forNight(Cfg, 9)
			expect(n1.drainFactor < n2.drainFactor).to.equal(true)
			expect(n2.drainFactor < n3.drainFactor).to.equal(true)
			expect(n3.phantomSpeedBonus > 0).to.equal(true)
			expect(n3).to.deepEqual(n9)
			local n0 = Escalation.forNight(Cfg, 0)
			expect(n0.drainFactor).to.equal(n1.drainFactor)
		end)
		it("last stand applies only in the survivor band", function()
			expect(Escalation.lastStandDrain(Cfg, 5)).to.equal(1)
			expect(Escalation.lastStandDrain(Cfg, 2)).to.equal(Cfg.LastStand.drainFactor)
			expect(Escalation.lastStandDrain(Cfg, 1)).to.equal(Cfg.LastStand.drainFactor)
			expect(Escalation.lastStandSpeed(Cfg, 2)).to.equal(Cfg.LastStand.speedBonus)
			expect(Escalation.lastStandSpeed(Cfg, 1)).to.equal(Cfg.LastStand.speedBonus)
			expect(Escalation.lastStandSpeed(Cfg, 3)).to.equal(0)
			expect(Escalation.lastStandDrain(Cfg, nil)).to.equal(1)
			-- speed bonus and drain relief must point the same way (a real comeback edge)
			expect(Escalation.lastStandSpeed(Cfg, 2) > 0).to.equal(true)
			expect(Escalation.lastStandDrain(Cfg, 2) < 1).to.equal(true)
		end)
		it("dawn rush kicks in past the threshold only", function()
			expect(Escalation.rushBoost(Cfg, 0)).to.equal(1)
			expect(Escalation.rushBoost(Cfg, Cfg.Rush.rebootAt - 0.01)).to.equal(1)
			expect(Escalation.rushBoost(Cfg, Cfg.Rush.rebootAt)).to.equal(Cfg.Rush.boost)
			expect(Escalation.rushBoost(Cfg, 1)).to.equal(Cfg.Rush.boost)
			expect(Escalation.rushBoost(Cfg, nil)).to.equal(1)
		end)
	end)
end
