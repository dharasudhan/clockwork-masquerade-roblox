{
  "name": "The Clockwork Masquerade",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "Action": {
          "$className": "RemoteEvent"
        },
        "Aim": {
          "$className": "RemoteEvent"
        },
        "Notify": {
          "$className": "RemoteEvent"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 256,
        "StreamingMinRadius": 96,
        "StreamingIntegrityMode": "PauseOutsideLoadedArea"
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "Packages": {
        "$path": "vendor"
      }
    },
    "ServerStorage": {
      "Tests": {
        "$className": "Folder",
        "framework": {
          "$path": "tests/framework"
        },
        "specs": {
          "$path": "tests/specs"
        }
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 22,
        "CharacterWalkSpeed": 16
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
